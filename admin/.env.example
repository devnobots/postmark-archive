# Copy to admin/.env.local and fill in at the very end (step D). Leave empty to use local mode.
# Browser-safe values (the anon key is meant to be public; the database rules protect the data):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only values (never VITE_...): used by /api/* on the dev server and on Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The secret key is for the Vercel build only (it reads the database to write data/current.js).
# Put it in Vercel's settings, not here, unless you want to try a full build on your computer.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
VERCEL_DEPLOY_HOOK_URL=
